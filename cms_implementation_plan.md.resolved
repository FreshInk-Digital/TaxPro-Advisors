    ['key' => 'hero.cta_primary', 'section' => 'hero',    'type' => 'text'],
    ['key' => 'hero.cta_secondary','section'=> 'hero',    'type' => 'text'],
    ['key' => 'hero.image',       'section' => 'hero',    'type' => 'image'],

    // ── About Section ─────────────────────────────
