### 4.2 API Endpoints to Add in `routes/api.php`

```php
// ── Site Content (CMS) ─────────────────────────────────────────
// PUBLIC: Frontend reads all content by locale (no auth needed)
Route::get('/site-content', [SiteContentController::class, 'index']);
Route::get('/site-content/{key}', [SiteContentController::class, 'show']);

// PROTECTED: Admin writes content
Route::middleware('auth:sanctum')->group(function () {
    Route::get('/admin/site-content', [SiteContentController::class, 'adminIndex']);
    Route::put('/site-content/{id}', [SiteContentController::class, 'update']);
    Route::post('/site-content/{id}/translations', [SiteContentController::class, 'upsertTranslation']);
    Route::post('/site-content/image', [SiteContentController::class, 'uploadImage']);
});
```

### 4.3 SiteContentController Logic

```php
// GET /api/v1/site-content  (Public, locale from Accept-Language header)
// Returns: { "hero.title": "Welcome to TaxProConsult", "about.body": "..." }
public function index(Request $request) {
    $locale = $request->header('Accept-Language', 'en');
    $language = Language::where('code', $locale)->first();

    $contents = SiteContent::with(['translations' => fn($q) =>
        $q->where('languageId', $language?->id)
    ])->where('is_active', true)->get();

    // Return as a flat key→value map for easy frontend use
    return response()->json(
        $contents->mapWithKeys(fn($c) => [
            $c->key => $c->translations->first()?->value
        ])
    );
}

// PUT /api/v1/site-content/{id}/translations  (Admin)
// Body: { languageId: 1, value: "New title text" }
public function upsertTranslation(Request $request, $id) {
    $content = SiteContent::findOrFail($id);
    SiteContentTranslation::updateOrCreate(
        ['siteContentId' => $id, 'languageId' => $request->languageId],
        ['value' => $request->value]
    );
    return response()->json(['success' => true]);
}
```

