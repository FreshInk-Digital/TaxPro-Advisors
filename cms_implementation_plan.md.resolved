    ['key' => 'nav.contact',      'section' => 'navbar',  'type' => 'text'],

    // ── Footer ────────────────────────────────────
    ['key' => 'footer.tagline',   'section' => 'footer',  'type' => 'text'],
    ['key' => 'footer.copyright', 'section' => 'footer',  'type' => 'text'],
];
```

