## 3. Database Design — Backend (Laravel)

### 3.1 New Migration: `site_contents` table

This is the core CMS table.

```sql
-- Two tables following your existing *Translation pattern

CREATE TABLE site_contents (
    id          BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    `key`       VARCHAR(255) NOT NULL,       -- e.g. "hero.title", "about.body"
    section     VARCHAR(100) NOT NULL,       -- e.g. "hero", "about", "navbar", "faq"
    type        ENUM('text','html','image','json') DEFAULT 'text',
    sort_order  INT DEFAULT 0,
    is_active   BOOLEAN DEFAULT TRUE,
    created_at  TIMESTAMP NULL,
    updated_at  TIMESTAMP NULL,
    UNIQUE KEY `site_contents_key_unique` (`key`)
);

CREATE TABLE site_content_translations (
    id              BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    siteContentId   BIGINT UNSIGNED NOT NULL,
    languageId      BIGINT UNSIGNED NOT NULL,
    value           LONGTEXT,               -- the actual content in this language
    created_at      TIMESTAMP NULL,
    updated_at      TIMESTAMP NULL,
    FOREIGN KEY (siteContentId) REFERENCES site_contents(id) ON DELETE CASCADE,
    FOREIGN KEY (languageId) REFERENCES languages(id) ON DELETE CASCADE,
    UNIQUE KEY `content_lang_unique` (`siteContentId`, `languageId`)
);
```

