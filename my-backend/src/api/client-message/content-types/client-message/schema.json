{
  "kind": "collectionType",
  "collectionName": "client_messages",
  "info": {
    "singularName": "client-message",
    "pluralName": "client-messages",
    "displayName": "client-message"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "integer"
    },
    "selectedService": {
      "type": "string"
    },
    "message": {
      "type": "text"
    },
    "sourcePage": {
      "type": "string"
    },
    "msg_status": {
      "type": "enumeration",
      "default": "new",
      "enum": [
        "new",
        "read",
        "replied",
        "archived"
      ]
    },
    "adminNotes": {
      "type": "text"
    }
  }
}
