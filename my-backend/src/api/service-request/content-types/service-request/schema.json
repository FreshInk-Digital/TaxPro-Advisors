    },
    "lastName": {
      "type": "string"
    },
    "companyName": {
      "type": "string"
    },
    "workEmail": {
      "type": "email"
    },
    "phoneNumber": {
      "type": "string"
    },
    "selectedService": {
      "type": "string"
    },
    "projectDetails": {
      "type": "text"
    },
    "supportingDocuments": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "services_status": {
      "type": "enumeration",
      "enum": [
